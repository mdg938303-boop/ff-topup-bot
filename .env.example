# ==============================
# TELEGRAM BOT
# ==============================
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# কমা দিয়ে একাধিক Admin Telegram ID
ADMIN_IDS=111111111,222222222
SUPPORT_USERNAME=@your_support_username

# ==============================
# DATABASE
# ==============================
# Local/Termux/VPS (SQLite) — ডিফল্ট:
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Render Postgres / Neon / যেকোনো Postgres — postgres:// বা postgresql:// যেটাই দিন, বট নিজেই ঠিক করে নেয়:
# DATABASE_URL=postgresql://user:password@host/dbname

# ==============================
# OPTIONAL
# ==============================
# FSM (চলমান ফর্ম) restart-এ টিকিয়ে রাখার জন্য Redis (Render Key Value)। না দিলে memory ব্যবহার হয়।
# REDIS_URL=redis://red-xxxx:6379

# Provider API key / Mr Ai Pay key ডাটাবেসে এনক্রিপ্ট করে রাখতে — যেকোনো লম্বা random string।
# ⚠️ এটা হারালে সংরক্ষিত key গুলো আর পড়া যাবে না — ব্যাকআপ রাখুন।
# SECRET_ENCRYPTION_KEY=put-a-long-random-string-here

# Telegram webhook secret (না দিলে BOT_TOKEN থেকে নিজে তৈরি হয়)
# WEBHOOK_SECRET=

# লিমিট (ডিফল্ট মান দেখানো হলো)
# MIN_DEPOSIT=10
# MAX_DEPOSIT=50000
# MAX_PENDING_DEPOSITS_PER_USER=3
# REFERRAL_MIN_DEPOSIT=50
# ORDER_STUCK_MINUTES=30

# ==============================
# PUBLIC URL (শুধু VPS/অন্য হোস্টে webhook চালালে; Render এটা নিজেই দেয়)
# ==============================
# PORT=8080
# WEBHOOK_BASE_URL=https://your-domain.com
